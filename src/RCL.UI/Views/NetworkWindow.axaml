<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RCL.UI.Views.NetworkWindow"
        Title="联机模块"
        Width="640" Height="560" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#ffffff">

  <DockPanel Margin="18">
    <TextBlock DockPanel.Dock="Top" Text="联机模块 · 服务器收藏与局域网扫描"
               FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
      <TextBox x:Name="TxtName" Width="150" Watermark="名称"/>
      <TextBox x:Name="TxtHost" Width="200" Watermark="地址 (如 mc.example.com)"/>
      <NumericUpDown x:Name="NumPort" Width="90" Value="25565" Minimum="1" Maximum="65535" FormatString="0" ShowButtonSpinner="False"/>
      <Button x:Name="BtnAdd" Content="添加" Padding="14,6" Background="#1f6feb" Foreground="White"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
      <Button x:Name="BtnScan" Content="扫描局域网" Padding="14,6"/>
      <Button x:Name="BtnCopy" Content="复制选中信息" Padding="14,6"/>
      <Button x:Name="BtnDelete" Content="删除选中" Padding="14,6"/>
      <TextBlock x:Name="TxtScan" VerticalAlignment="Center" FontSize="11" Foreground="#8a93a3"/>
    </StackPanel>

    <ListBox x:Name="LstServers" Margin="0,0,0,10" BorderBrush="#e3e6eb" BorderThickness="1" CornerRadius="8">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="*,Auto" Margin="4,3">
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
              <TextBlock Text="{Binding Host}" FontSize="11" Foreground="#8a93a3"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Port}" VerticalAlignment="Center"
                       FontSize="12" Foreground="#5b6472"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Background="#eef4ff" CornerRadius="8" Padding="12">
      <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#2b4d86"
                 Text="提示：本模块用于收藏服务器地址与扫描局域网内正在运行的 MC 服务端（端口 25565）。加入游戏请在游戏内“多人游戏”中输入地址。联机本身免费，但需要对方服务器在线且你的网络可达。"/>
    </Border>
  </DockPanel>
</Window>
