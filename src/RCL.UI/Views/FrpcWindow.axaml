<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RCL.UI.Views.FrpcWindow"
        Title="内网穿透模块"
        Width="720" Height="600" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#ffffff">

  <DockPanel Margin="18">
    <TextBlock DockPanel.Dock="Top" Text="内网穿透（frp）· 把内网服务映射为公网地址"
               FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

    <Border DockPanel.Dock="Top" Background="#fff8e6" BorderBrush="#f0d9a0" BorderThickness="1"
            CornerRadius="6" Padding="10" Margin="0,0,0,10">
      <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#7a5200"
                 Text="使用前需自备一台有公网 IP 的服务器并部署 frps（开源项目 fatedier/frp）。启动器只负责 frpc 客户端：填入你的 frps 地址、令牌与端口即可。"/>
    </Border>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="120,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,10">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="frps 地址" VerticalAlignment="Center" FontSize="12"/>
      <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtAddr" Watermark="例如 1.2.3.4"/>
      <TextBlock Grid.Row="1" Grid.Column="0" Text="frps 端口" VerticalAlignment="Center" FontSize="12"/>
      <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="NumSrvPort" Value="7000" Minimum="1" Maximum="65535" FormatString="0" ShowButtonSpinner="False" Width="160" HorizontalAlignment="Left"/>
      <TextBlock Grid.Row="2" Grid.Column="0" Text="令牌 Token" VerticalAlignment="Center" FontSize="12"/>
      <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtToken" Watermark="与 frps 一致"/>
      <TextBlock Grid.Row="3" Grid.Column="0" Text="本地端口" VerticalAlignment="Center" FontSize="12"/>
      <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="NumLocal" Value="25565" Minimum="1" Maximum="65535" FormatString="0" ShowButtonSpinner="False" Width="160" HorizontalAlignment="Left"/>
      <TextBlock Grid.Row="4" Grid.Column="0" Text="远程端口" VerticalAlignment="Center" FontSize="12"/>
      <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="NumRemote" Value="25565" Minimum="1" Maximum="65535" FormatString="0" ShowButtonSpinner="False" Width="160" HorizontalAlignment="Left"/>
      <TextBlock Grid.Row="5" Grid.Column="0" Text="类型" VerticalAlignment="Center" FontSize="12"/>
      <ComboBox Grid.Row="5" Grid.Column="1" x:Name="CmbType" Width="120" HorizontalAlignment="Left" SelectedIndex="0">
        <ComboBoxItem Content="tcp"/>
        <ComboBoxItem Content="udp"/>
      </ComboBox>
      <TextBlock Grid.Row="6" Grid.Column="0" Text="frpc 路径" VerticalAlignment="Center" FontSize="12"/>
      <Grid Grid.Row="6" Grid.Column="1" ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0" x:Name="TxtPath" Watermark="留空则自动下载到本地 tools 目录"/>
        <Button Grid.Column="1" x:Name="BtnBrowse" Content="浏览" Padding="10,4" Margin="8,0,0,0"/>
      </Grid>
    </Grid>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
      <Button x:Name="BtnCheck" Content="检查/下载 frpc" Padding="14,6" Background="#d9822b" Foreground="White"/>
      <Button x:Name="BtnStart" Content="生成配置并启动" Padding="14,6" Background="#2ea043" Foreground="White"/>
      <Button x:Name="BtnStop" Content="停止" Padding="14,6"/>
    </StackPanel>

    <TextBox x:Name="TxtLog" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
             Background="#16181d" Foreground="#c9d1df" BorderThickness="0" CornerRadius="6"
             TextWrapping="Wrap" AcceptsReturn="True" Padding="10,8"/>
  </DockPanel>
</Window>
