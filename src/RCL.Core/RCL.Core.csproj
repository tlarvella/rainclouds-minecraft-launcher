<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RCL.Core</AssemblyName>
    <RootNamespace>RCL.Core</RootNamespace>
    <LangVersion>10</LangVersion>
  </PropertyGroup>

  <!-- 内嵌 Rainclouds 自研核心：加载器 jar + 演示 Mod jar -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\rainclouds-core.jar" />
    <EmbeddedResource Include="Resources\rainclouds-hello.jar" />
    <EmbeddedResource Include="Resources\rainclouds-fps.jar" />
    <EmbeddedResource Include="Resources\rainclouds-spawn.jar" />
  </ItemGroup>

  <!-- 内嵌「离线资料馆 / 彩蛋」资源包：像素风壁纸、无损音效、离线资料。
       这些资源随单文件 exe 一起发布，离线可用；由 tools/gen_extras.py 生成。 -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Extras\index.json" />
    <EmbeddedResource Include="Resources\Extras\wallpapers\*.png" />
    <EmbeddedResource Include="Resources\Extras\audio\*.wav" />
    <EmbeddedResource Include="Resources\Extras\data\*" />
  </ItemGroup>

</Project>
